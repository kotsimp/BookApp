# Virtual environment
.venv/
venv/
env/

# Temp files (uploads and generated outputs)
temp/

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Distribution
dist/
build/
*.egg-info/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Environment variables and sensitive settings
.env
.env.local
config/settings.json

# Local SQLite database files
data/*.db
data/*.db-wal
data/*.db-shm
data/batch_queue.json
data/*.tmp
config/*.corrupt
config/*.tmp

# One-time first-administrator setup code (user accounts mode)
data/setup_code.txt

# Per-user e-reader link hashes (📲 Devices)
data/connections.json
data/.connections.json.*

# Per-user library data: reading-position sync (sync password hashes, positions), series, Glossary suggestions
data/reading_sync.json
data/series.json
data/glossary_suggestions.json
data/.reading_sync.json.*
data/.series.json.*
data/.glossary_suggestions.json.*

# A store that could not be read, kept before it is replaced
data/*.corrupt
